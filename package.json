{
  "name": "art-ui",
  "version": "1.0.0",
  "description": "ArtUI — An art-focused React UI component library for portfolios, photography showcases, galleries, and creative projects. 108 components, zero runtime deps.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kllin8154-arch/art-ui.git"
  },
  "homepage": "https://github.com/kllin8154-arch/art-ui#readme",
  "bugs": {
    "url": "https://github.com/kllin8154-arch/art-ui/issues"
  },
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly --declaration --outDir dist",
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "keywords": [
    "react",
    "ui-library",
    "art",
    "gallery",
    "photography",
    "creative",
    "design-system",
    "typescript",
    "artistic",
    "portfolio"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=17.0.0",
    "react-dom": ">=17.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0"
  }
}
